# OpenRouter key used for both the system under test and the LLM judge.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slugs (OpenRouter ids). Both are recorded in every results row.
# System under test: same family as the production assistant this mirrors.
SUT_MODEL=google/gemini-2.5-flash
# Judge: a different model family from the SUT to avoid self-preference.
# Verified live on OpenRouter 2026-09-14.
JUDGE_MODEL=anthropic/claude-sonnet-5

# Keep promptfoo from phoning home.
PROMPTFOO_DISABLE_TELEMETRY=1
